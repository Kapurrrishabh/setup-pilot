# Copy this file to .env and fill it in. Never commit .env.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Supabase > Connect > Session pooler string, with your database password in place of [YOUR-PASSWORD]
SUPABASE_DB_URL=

# Optional LangSmith tracing (free tier). Leave LANGSMITH_TRACING=false to turn it off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=setuppilot
